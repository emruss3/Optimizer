# Optional HTTPS endpoint for the authenticated Cycles worker in scripts/render4k.
# Without it, the workspace can export the native 4K scene package to Blender.
VITE_RENDER_SERVICE_URL=
# Parcel tiles (docs/PARCEL_TILES.md). Unset = the live edge tiles (legacy).
# VITE_PARCEL_TILES=candidate
# VITE_PARCEL_TILES_MANIFEST=https://<project>.supabase.co/storage/v1/object/public/parcel-tiles/manifest.json
